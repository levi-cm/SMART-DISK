# Copy this file to .env and fill in the private values.
# Do not commit .env.
TELEGRAM_BOT_TOKEN=replace-with-your-telegram-bot-token
HOST_NAME=smart-watcher
SMART_POLICY=paranoid
BURST_COUNT=10
BURST_DELAY=30
# Optional Bot API base URL; unset means https://api.telegram.org. Every
# request carries the token, so only point this at a server you control
# (a self-hosted Bot API server, or the offline smoke test's mock).
# TELEGRAM_API_BASE=https://api.telegram.org
